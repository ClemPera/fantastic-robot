# Create a SEPARATE Bluesky account for the bot - never plug your main
# account's real password in here. Use Settings > App Passwords to generate
# BSKY_APP_PASSWORD.
BSKY_HANDLE=yourbot.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Letta server's brain ---
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

LETTA_MODEL=google_ai/gemini-flash-latest

# Embeddings run locally via Ollama (docker-compose.yml), not Gemini -
# Gemini embeddings don't currently work in Letta - and not OpenAI either,
# to keep this fully local and free. all-minilm (~46MB) is the default,
# light enough for a Raspberry Pi. If you have RAM/storage to spare and want
# better recall quality, switch this AND the model name in docker-compose's
# ollama-pull service to ollama/nomic-embed-text (~274MB).
LETTA_EMBEDDING=ollama/all-minilm

# The only Bluesky account this bot will ever treat as an authority. Nobody
# else can give it instructions, no matter what they claim in a post.
ADMIN_DID=did:plc:hicaseq6reyxfiq5vo7okwwr
ADMIN_HANDLE=imkitsune.bsky.social

POLL_SECONDS=30

# Not used when running via docker-compose (LETTA_BASE_URL and STATE_FILE
# are set for you in docker-compose.yml). Only relevant if you run
# `python bot.py` directly on your machine instead.
# LETTA_BASE_URL=http://localhost:8283
# STATE_FILE=bot_state.json
