# Create a SEPARATE Bluesky account for the bot - never plug your main
# account's real password in here. Use Settings > App Passwords to generate
# BSKY_APP_PASSWORD.
BSKY_HANDLE=yourbot.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Letta: pick ONE of the two ---

# Option A: self-hosted Letta server (see README for the docker run command)
LETTA_BASE_URL=http://localhost:8283

# Option B: Letta Cloud instead of self-hosting
# LETTA_API_KEY=sk-...

# Must match a model/embedding your Letta server actually has a provider key for
LETTA_MODEL=openai/gpt-4o-mini
LETTA_EMBEDDING=openai/text-embedding-3-small

POLL_SECONDS=30
STATE_FILE=bot_state.json

BOT_PERSONA=I am a friendly Bluesky bot. I keep replies under 280 characters and remember what people tell me.
